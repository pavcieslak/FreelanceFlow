{
  "name": "projectflow",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "setup": "bash .devcontainer/setup.sh",
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npm run --silent ts -- prisma/seed.ts",
    "db:migrate-from-sqlite": "npm run --silent ts -- scripts/migrateFromSqlite.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "user:set": "npm run --silent ts -- scripts/setUserPassword.ts",
    "ts": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\"}' node --env-file-if-exists=.env --env-file-if-exists=.env.local -r ts-node/register"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.1.6",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.469.0",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^13.0.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
