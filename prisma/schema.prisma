generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  password    String
  name        String?
  createdAt   DateTime    @default(now())
  /// Bumped whenever the password changes. Sessions issued before this instant
  /// are rejected, so a reset actually locks out whoever had the old password.
  passwordChangedAt DateTime?
  settings    Settings?
  clients     Client[]
  projects    Project[]
  tags        Tag[]
  timeEntries TimeEntry[]
  invoices    Invoice[]
  passwordResetTokens PasswordResetToken[]
}

/// Single-use, expiring password reset tokens.
/// Only the SHA-256 hash of the token is stored — a database leak therefore
/// doesn't hand an attacker usable reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Settings {
  id                String  @id @default(cuid())
  userId            String  @unique
  fullName          String?
  businessName      String?
  email             String?
  address           String?
  phone             String?
  logo              String?
  defaultCurrency   String  @default("USD")
  defaultHourlyRate Float   @default(0)
  monthlyExpenses   Float   @default(0)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id               String    @id @default(cuid())
  userId           String
  clockifyClientId String?
  name             String
  email            String?
  address          String?
  currency         String    @default("USD")
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects         Project[]
  invoices         Invoice[]

  @@unique([userId, clockifyClientId])
  @@index([userId, archived])
}

model Project {
  id                String      @id @default(cuid())
  userId            String
  name              String
  color             String      @default("#3b82f6")
  clientId          String?
  hourlyRate        Float       @default(0)
  currency          String      @default("USD")
  billableByDefault Boolean     @default(true)
  archived          Boolean     @default(false)
  createdAt         DateTime    @default(now())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client            Client?     @relation(fields: [clientId], references: [id])
  tasks             Task[]
  timeEntries       TimeEntry[]

  @@index([userId, archived])
  @@index([clientId])
}

model Task {
  id          String      @id @default(cuid())
  name        String
  projectId   String
  archived    Boolean     @default(false)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([projectId])
}

model Tag {
  id          String         @id @default(cuid())
  userId      String
  name        String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntryTag[]

  @@unique([userId, name])
}

model TimeEntry {
  id           String         @id @default(cuid())
  userId       String
  description  String?
  projectId    String?
  taskId       String?
  mode         String         @default("TIMER")
  isPlanned    Boolean        @default(false)
  startTime    DateTime
  endTime      DateTime?
  duration     Int?
  billable     Boolean        @default(true)
  invoiced     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?       @relation(fields: [projectId], references: [id])
  task         Task?          @relation(fields: [taskId], references: [id])
  tags         TimeEntryTag[]
  invoiceItems InvoiceItem[]

  @@index([userId, startTime])
  @@index([userId, isPlanned])
  @@index([projectId])
  @@index([taskId])
}

model TimeEntryTag {
  timeEntryId String
  tagId       String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([timeEntryId, tagId])
}

model Invoice {
  id                String        @id @default(cuid())
  userId            String
  clockifyInvoiceId String?
  number            String
  clientId          String
  status            String        @default("DRAFT")
  issueDate         DateTime      @default(now())
  /// Optional: some invoices are issued without an agreed payment deadline.
  dueDate           DateTime?
  subject           String?
  notes             String?
  currency          String        @default("USD")
  taxRate           Float         @default(0)
  paidAmount        Float         @default(0)
  balanceAmount     Float         @default(0)
  sentAt            DateTime?
  paidAt            DateTime?
  stripeSessionId   String?
  paymentUrl        String?
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client            Client        @relation(fields: [clientId], references: [id])
  items             InvoiceItem[]

  @@unique([userId, number])
  @@unique([userId, clockifyInvoiceId])
  @@index([userId, status])
  @@index([clientId])
}

model InvoiceItem {
  id          String     @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  amount      Float
  timeEntryId String?
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id])

  @@index([invoiceId])
  @@index([timeEntryId])
}

/// Records Stripe event ids that have already been applied, so retried or
/// duplicated webhook deliveries are ignored instead of double-processed.
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
