# Copy this file to `.env` (not `.env.local`).
#
# Next.js reads both, but the Prisma CLI only reads `.env` — with the values in
# `.env.local` alone, `prisma migrate deploy` fails with
# "Environment variable not found: DATABASE_URL".

# PostgreSQL connection string
DATABASE_URL="postgresql://projectflow:projectflow@localhost:5432/projectflow"

# NextAuth
NEXTAUTH_SECRET=your-random-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Public base URL of the app (used in payment/email links)
APP_URL=http://localhost:3000

# Optional: seed account for `npm run db:seed`
AUTH_EMAIL=admin@projectflow.com
AUTH_PASSWORD=your-secure-password

# Optional: Sign in / register with Google.
# All three are required together. GOOGLE_ALLOWED_EMAILS is not optional: it is
# the entire authorisation model, and without it enabling Google would let
# anyone with a Google account create an account on this instance. An empty
# list denies everyone rather than allowing everyone.
# Authorised redirect URI in Google Cloud: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: Clockify invoice import
CLOCKIFY_API_KEY=your-clockify-api-key
CLOCKIFY_WORKSPACE_ID=your-clockify-workspace-id

# Optional: Stripe payments (invoice payment links + webhook)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: transactional email via Resend (invoice sending)
RESEND_API_KEY=re_...
EMAIL_FROM="ProjectFlow <invoices@yourdomain.com>"

# Backups. The `backup` service dumps the database into ./backups on this
# schedule and keeps this many days of dumps. Defaults are daily / 14 days.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Optional: command run after each successful dump, with the dump path as $1.
# Local dumps sit on the same disk as the database, so they do not survive
# losing the host — this is what gets a copy off the machine.
# BACKUP_POST_HOOK=rclone copy "$1" remote:projectflow-backups
